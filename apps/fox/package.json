{
  "name": "@gekko/fox",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type:check": "bun tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/fox.tsbuildinfo",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:exec": "bun build --compile src/fox.ts src/worker/gekko.worker.ts --outfile ../../dist/fox",
    "dev": "bun src/fox.ts"
  },
  "dependencies": {
    "@gekko/core": "workspace:*",
    "@gekko/plugins": "workspace:*",
    "@gekko/schemas": "workspace:*",
    "@gekko/shared": "workspace:*",
    "@gekko/strategies": "workspace:*",
    "commander": "^15.0.0",
    "lodash-es": "^4.17.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
