{
  "name": "@gekko/shared",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type:check": "bun tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/shared.tsbuildinfo",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "vitest --run bench",
    "bench:watch": "vitest bench"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.23"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
