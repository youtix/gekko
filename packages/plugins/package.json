{
  "name": "@gekko/plugins",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type:check": "bun tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/plugins.tsbuildinfo",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gekko/core": "workspace:*",
    "@gekko/indicators": "workspace:*",
    "@gekko/schemas": "workspace:*",
    "@gekko/shared": "workspace:*",
    "@gekko/strategies": "workspace:*",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
