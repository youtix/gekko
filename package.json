{
  "name": "gekko",
  "version": "2.0.0",
  "description": "A modular crypto trading bot framework supporting backtesting, real-time trading, and custom strategies.",
  "keywords": [
    "trading",
    "bot",
    "crypto",
    "cryptocurrency",
    "trading-bot",
    "backtest",
    "backtesting",
    "real-time",
    "strategies",
    "indicators",
    "automated-trading",
    "technical-analysis",
    "gekko",
    "exchange",
    "finance",
    "market-data",
    "trading-strategy",
    "trading-algorithms",
    "plugin-architecture"
  ],
  "author": "youtix",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun apps/gekko/src/gekko.ts",
    "dev:fox": "bun apps/fox/src/fox.ts",
    "build:exec": "turbo run build:exec",
    "type:check": "turbo run type:check type:check:scripts",
    "type:check:scripts": "bun tsc --noEmit -p tsconfig.scripts.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/scripts.tsbuildinfo",
    "lint": "bun eslint . --fix",
    "lint:check": "bun eslint .",
    "format": "bun prettier . --write",
    "format:check": "prettier --check .",
    "test": "turbo run test test:scripts --concurrency=1",
    "test:scripts": "vitest --run",
    "test:coverage": "turbo run test:coverage test:coverage:scripts --concurrency=1",
    "test:coverage:scripts": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e",
    "bench": "turbo run bench --concurrency=1",
    "commit:check": "commitlint",
    "release": "bun semantic-release",
    "preinstall": "git update-index --skip-worktree ./packages/strategies/src/custom/index.ts 2>/dev/null || true",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/bun": "^1.3.9",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "semantic-release": "^24.2.5",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
